<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Crit float: 2dp ember underline. -->
    <item android:gravity="bottom|fill_horizontal" android:height="2dp">
        <shape android:shape="rectangle"><solid android:color="@color/ae_ember"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <padding android:left="4dp" android:right="4dp" android:top="0dp" android:bottom="4dp"/>
        </shape>
    </item>
</layer-list>
