<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ash & Ember soot panel: soot fill + rim, inset hairline, amber corner ornaments. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ae_soot_panel"/>
            <stroke android:width="1dp" android:color="@color/ae_rim"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1dp" android:color="@color/ae_wax"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:drawable="@drawable/ic_corner_ornament_tl" android:gravity="top|start" android:width="16dp" android:height="16dp" android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"/>
    <item android:drawable="@drawable/ic_corner_ornament_tr" android:gravity="top|end" android:width="16dp" android:height="16dp" android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"/>
    <item android:drawable="@drawable/ic_corner_ornament_bl" android:gravity="bottom|start" android:width="16dp" android:height="16dp" android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"/>
    <item android:drawable="@drawable/ic_corner_ornament_br" android:gravity="bottom|end" android:width="16dp" android:height="16dp" android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"/>
</layer-list>
