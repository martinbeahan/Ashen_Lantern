<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed buttons: text/content shifts down 1dp (no elevation, no flashing). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_enabled="true">
        <objectAnimator android:propertyName="translationY" android:duration="40" android:valueTo="1dp" android:valueType="floatType"/>
    </item>
    <item>
        <objectAnimator android:propertyName="translationY" android:duration="60" android:valueTo="0dp" android:valueType="floatType"/>
    </item>
</selector>
