<?xml version="1.0" encoding="utf-8"?>
<!-- An unlit lantern (empty save slot): dashed ash border, hollow lantern, Begin. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_adventure_empty"
    android:gravity="center_vertical"
    android:minHeight="96dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_lantern_unlit" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel"
            android:text="An unlit slot"
            android:textColor="@color/ae_bone"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant"
            android:text="Begin a new story or crawl."
            android:textColor="@color/ae_fog"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>

    <Button
        android:id="@+id/emptyBegin"
        style="@style/Widget.DnD.ActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:minWidth="96dp"
        android:text="Begin"
        android:textSize="12sp" />
</LinearLayout>
