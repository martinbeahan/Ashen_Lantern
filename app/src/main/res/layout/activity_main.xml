<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ae_void"
    android:padding="6dp">

    <!-- Slim production HUD -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_hud_panel"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="4dp">

            <TextView
                android:fontFamily="@font/cinzel"
                android:id="@+id/turnBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_turn_banner"
                android:text="Your turn"
                android:textColor="@color/gold_bright"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:fontFamily="@font/cormorant"
                android:id="@+id/playerStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Room 1"
                android:textColor="@color/parchment"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:id="@+id/hudXpRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:fontFamily="@font/cinzel"
                    android:id="@+id/hudXpLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XP"
                    android:textColor="@color/gold"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <com.fintrack.dndbeginnerremote.EmberXpView
                    android:id="@+id/hudXpBar"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1" />

                <TextView
                    android:fontFamily="@font/cormorant"
                    android:id="@+id/hudXpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/100"
                    android:textColor="@color/parchment_dark"
                    android:textSize="12sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnJournal"
            style="@style/Widget.DnD.HudChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnSheet"
            style="@style/Widget.DnD.HudChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="Sheet"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnCompanion"
            style="@style/Widget.DnD.HudChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="Ally"
            android:maxLines="1"
            android:contentDescription="Companion" />

        <Button
            android:id="@+id/btnHelp"
            style="@style/Widget.DnD.HudChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="?"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnInGameSettings"
            style="@style/Widget.DnD.HudChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="⚙"
            android:maxLines="1"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Narration card (Lanternkeeper voice): soot, 3dp amber bar, Cormorant italic -->
    <LinearLayout
        android:id="@+id/narrationCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:background="@drawable/bg_narration_card"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/roomDescText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant"
            android:text="The torchlight flickers…"
            android:textColor="@color/ae_bone"
            android:textSize="14sp"
            android:textStyle="italic"
            android:lineSpacingExtra="1dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/narrationAttribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant"
            android:text="@string/narration_attribution"
            android:textColor="@color/ae_amber"
            android:textSize="12sp"
            android:textStyle="italic"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Battle stage (main focus) + FX overlay for floating damage -->
    <FrameLayout
        android:id="@+id/battleStageHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/narrationCard"
        android:layout_above="@id/bottomControls"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <!-- Stage art: centre-cropped, never stretched (bg_stage_* / _hd picked at runtime). -->
        <ImageView
            android:id="@+id/battleStageImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_stage_catacombs"
            android:importantForAccessibility="no" />

        <!-- Boss fights: stronger teal from the right + heavier vignette -->
        <View
            android:id="@+id/battleBossOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_stage_boss_overlay"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/battleArena"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center"
            android:background="@drawable/bg_battle_stage_shade"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/partyColumn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical|start"
                android:clipChildren="false" />

            <TextView
                android:fontFamily="@font/cinzel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ae_amber"
                android:alpha="0.7"
                android:letterSpacing="0.08"
                android:padding="4dp" />

            <LinearLayout
                android:id="@+id/enemyColumn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical|end"
                android:clipChildren="false" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/battleFxOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/combatFlashOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />
    </FrameLayout>


    <!-- Bottom: actions + slim event ticker -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@drawable/bg_hud_panel"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ScrollView
            android:id="@+id/combatLogScroll"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:minHeight="72dp"
            android:fillViewport="false"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:paddingBottom="4dp"
            android:overScrollMode="ifContentScrolls">
            <TextView
                android:fontFamily="@font/cormorant"
                android:id="@+id/combatLogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The adventure begins…"
                android:textColor="@color/parchment"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />
        </ScrollView>

        <!-- Hidden chat row kept for code compatibility; collapsed by default height 0 via gone -->
        <LinearLayout
            android:id="@+id/chatRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            <EditText
                android:fontFamily="@font/cormorant"
                android:id="@+id/chatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Say something…"
                android:textColor="@color/parchment"
                android:textColorHint="@color/ae_fog"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnSendChat"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Send" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fadeScrollbars="true">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="2dp">

                <Button
                    android:id="@+id/btnAttack"
                    style="@style/Widget.DnD.ActionButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="68dp"
                    android:text="⚔&#10;Attack"
                    android:textSize="11sp"
                    android:layout_marginEnd="5dp" />
                <Button
                    android:id="@+id/btnSpecial"
                    style="@style/Widget.DnD.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="68dp"
                    android:text="✦&#10;Special"
                    android:textSize="11sp"
                    android:layout_marginEnd="5dp" />
                <Button
                    android:id="@+id/btnHeal"
                    style="@style/Widget.DnD.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="68dp"
                    android:text="⚗&#10;Potion"
                    android:textSize="11sp"
                    android:layout_marginEnd="5dp" />
                <Button
                    android:id="@+id/btnInteract"
                    style="@style/Widget.DnD.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="68dp"
                    android:text="🔍&#10;Search"
                    android:textSize="11sp"
                    android:layout_marginEnd="5dp" />
                <Button
                    android:id="@+id/btnRest"
                    style="@style/Widget.DnD.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="68dp"
                    android:text="🌙&#10;Rest"
                    android:textSize="11sp"
                    android:layout_marginEnd="5dp" />
                <Button
                    android:id="@+id/btnReset"
                    style="@style/Widget.DnD.ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:text="Menu"
                    android:textSize="11sp"
                    android:visibility="gone" />
                <!-- spacer id kept for old code references if any -->
                <Button android:id="@+id/id_spacer1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Keep logScrollView id for compatibility (unused visually) -->
    <ScrollView
        android:id="@+id/logScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <include
        layout="@layout/overlay_dice"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        layout="@layout/overlay_main_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        layout="@layout/overlay_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</RelativeLayout>
