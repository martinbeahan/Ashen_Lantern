<?xml version="1.0" encoding="utf-8"?>
<!-- Memory Ledger overlay (v2.26): soot panel on the dimmed backdrop, Cinzel titles, Cormorant body. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ae_scrim"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/bg_menu_panel"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null"
            android:src="@drawable/ic_memory_ember" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="MEMORY LEDGER"
            android:textColor="@color/ae_amber"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant"
            android:gravity="center"
            android:text="Souls that still have something to say."
            android:textColor="@color/ae_bone"
            android:textSize="14sp"
            android:textStyle="italic" />

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_section_rule" />

        <TextView
            android:id="@+id/ledgerProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel"
            android:gravity="center"
            android:paddingTop="4dp"
            android:textColor="@color/ae_bone"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/ledgerPips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/ledgerTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel"
            android:letterSpacing="0.1"
            android:paddingTop="8dp"
            android:text="SOURCE"
            android:textColor="@color/ae_fog"
            android:textSize="10sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/ledgerSources"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="8dp" />
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/ledgerScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="true">
            <LinearLayout
                android:id="@+id/ledgerCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/ledgerFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant"
            android:gravity="center"
            android:paddingTop="6dp"
            android:textColor="@color/ae_fog"
            android:textSize="13sp"
            android:textStyle="italic" />

        <Button
            android:id="@+id/ledgerClose"
            style="@style/Widget.DnD.ActionButton"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:minHeight="44dp"
            android:text="Close" />
    </LinearLayout>
</FrameLayout>
