<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ae_void"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- Menu backdrop: centre-cropped, never stretched (_hd picked at runtime on larger screens). -->
    <ImageView
        android:id="@+id/mainMenuBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu_backdrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_menu_root"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:background="@drawable/bg_menu_panel"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/mainMenuTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/cinzel_title"
                android:text="@string/app_name"
                android:textColor="@color/ae_amber"
                android:textSize="26sp"
                android:letterSpacing="0.02"
                android:textStyle="bold"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/mainMenuSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/cormorant"
                android:text="Choose your path"
                android:textColor="@color/ae_bone"
                android:textSize="14sp"
                android:textStyle="italic"
                android:paddingBottom="6dp" />

            <View
                android:layout_width="160dp"
                android:layout_height="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_section_rule" />

            <TextView
                android:fontFamily="@font/cinzel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="DIFFICULTY"
                android:textColor="@color/ae_amber"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingBottom="2dp" />

            <TextView
                android:fontFamily="@font/cormorant"
                android:id="@+id/mainMenuDifficultyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Difficulty: Easy"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:paddingBottom="4dp" />

            <Button
                android:id="@+id/btnMenuDifficulty"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginBottom="10dp"
                android:text="Change difficulty"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnMenuContinue"
                style="@style/Widget.DnD.ActionButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="6dp"
                android:text="Continue"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:fontFamily="@font/cinzel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="PLAY"
                android:textColor="@color/ae_amber"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

            <Button
                android:id="@+id/btnMenuSolo"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="6dp"
                android:text="Story adventure"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMenuCrawl"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="6dp"
                android:text="Dungeon Crawl"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMenuRaid"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="2dp"
                android:text="Boss Raid"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mainMenuRaidHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/cormorant"
                android:text="Finish the story first (Acts 1–3)"
                android:textColor="@color/ae_fog"
                android:textStyle="italic"
                android:textSize="13sp"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/btnMenuChallenge"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="2dp"
                android:text="Challenge Dungeon"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mainMenuChallengeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/cormorant"
                android:text="Finish the story first (Acts 1–3)"
                android:textColor="@color/ae_fog"
                android:textStyle="italic"
                android:textSize="13sp"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/btnMenuArena"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="2dp"
                android:text="Arena (Ember Ring)"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mainMenuArenaHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/cormorant"
                android:text="Finish the story first (Acts 1–3)"
                android:textColor="@color/ae_fog"
                android:textStyle="italic"
                android:textSize="13sp"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/btnMenuEndless"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="2dp"
                android:text="Endless Deep (Ashen Deep)"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mainMenuEndlessHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/cormorant"
                android:text="Finish the story first (Acts 1–3)"
                android:textColor="@color/ae_fog"
                android:textStyle="italic"
                android:textSize="13sp"
                android:paddingBottom="6dp" />

            <TextView
                android:fontFamily="@font/cinzel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="DAILY QUESTS"
                android:textColor="@color/ae_amber"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/mainMenuDailyQuests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/cormorant"
                android:text="Finish the story to unlock Daily Quests"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:paddingBottom="4dp" />

            <Button
                android:id="@+id/btnMenuClaimDaily"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_marginBottom="6dp"
                android:text="Claim daily rewards"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnMenuLedger"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Memory Ledger"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mainMenuLedgerHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/cormorant"
                android:text="Finish the Kindling to open the glass."
                android:textColor="@color/parchment_dark"
                android:textSize="12sp"
                android:paddingBottom="6dp" />

            <Button
                android:id="@+id/btnMenuHost"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="6dp"
                android:text="Host online (Lanternkeeper)"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMenuJoin"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="8dp"
                android:text="Join session"
                android:textSize="14sp" />

            <View
                android:layout_width="160dp"
                android:layout_height="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_section_rule" />

            <Button
                android:id="@+id/btnMenuSettings"
                style="@style/Widget.DnD.ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginBottom="6dp"
                android:text="Settings"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnMenuQuit"
                style="@style/Widget.DnD.ActionButton.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="Quit (background)"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
