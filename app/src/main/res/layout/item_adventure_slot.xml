<?xml version="1.0" encoding="utf-8"?>
<!-- A lit lantern (filled save slot). The last-used card swaps to bg_adventure_card_last + LAST. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slotCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_adventure_card"
    android:orientation="horizontal"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="92dp"
        android:background="@drawable/bg_adventure_portrait"
        android:padding="4dp">
        <ImageView
            android:id="@+id/slotPortrait"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/slotName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/cinzel"
                android:maxLines="1"
                android:textColor="@color/ae_bone"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/slotLast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel"
                android:letterSpacing="0.12"
                android:text="LAST"
                android:textColor="@color/ae_amber"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/slotLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant"
            android:textColor="@color/ae_amber"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/slotProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant"
            android:textColor="@color/ae_bone"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/slotPlayed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant"
            android:textColor="@color/ae_fog"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/slotContinue"
                style="@style/Widget.DnD.ActionButton.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:text="Continue"
                android:textSize="12sp" />
            <Button
                android:id="@+id/slotDelete"
                style="@style/Widget.DnD.ActionButton.Danger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:text="Delete"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
