<?xml version="1.0" encoding="utf-8"?>
<!-- Adventures picker (v2.28): three lanterns on the dimmed backdrop. Ash & Ember kit, no animation. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ae_scrim"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/bg_menu_panel"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:paddingTop="4dp"
            android:text="ADVENTURES"
            android:textColor="@color/ae_amber"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adventuresSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant"
            android:gravity="center"
            android:text="Three lanterns. Three lives."
            android:textColor="@color/ae_bone"
            android:textSize="14sp"
            android:textStyle="italic" />

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_section_rule" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="true">
            <LinearLayout
                android:id="@+id/adventuresList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="Continue on the main menu loads the last-used lantern.\nHost / Join never touch these saves."
            android:textColor="@color/ae_fog"
            android:textSize="13sp"
            android:textStyle="italic" />

        <Button
            android:id="@+id/adventuresClose"
            style="@style/Widget.DnD.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="44dp"
            android:text="Back to menu" />
    </LinearLayout>
</FrameLayout>
